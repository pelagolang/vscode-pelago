{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pelago Manifest",
  "scopeName": "source.pelago-manifest",
  "patterns": [
    { "include": "#comment" },
    { "include": "#key" },
    { "include": "#list-item" },
    { "include": "#value" }
  ],
  "repository": {
    "comment": {
      "match": "(?:^|(?<=\\s))(#).*$",
      "name": "comment.line.number-sign.pelago-manifest",
      "captures": { "1": { "name": "punctuation.definition.comment.pelago-manifest" } }
    },
    "list-item": {
      "match": "^\\s*(-)(?=\\s|$)",
      "captures": { "1": { "name": "punctuation.definition.block.sequence.item.pelago-manifest" } }
    },
    "key": {
      "match": "^\\s*(?:(-)\\s+)?((?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^']|'')*'|[^\\s#:\"'\\[\\]{}&*!|>%@`-][^#:]*?))\\s*(:)(?=\\s|$)",
      "captures": {
        "1": { "name": "punctuation.definition.block.sequence.item.pelago-manifest" },
        "2": { "name": "support.type.property-name.pelago-manifest" },
        "3": { "name": "punctuation.separator.key-value.pelago-manifest" }
      }
    },
    "value": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string-double" },
        { "include": "#string-single" },
        { "include": "#empty" },
        { "include": "#boolean" },
        { "include": "#integer" }
      ]
    },
    "string-double": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.pelago-manifest",
      "patterns": [{ "include": "#escape" }]
    },
    "string-single": {
      "match": "'(?:[^']|'')*'",
      "name": "string.quoted.single.pelago-manifest"
    },
    "escape": {
      "match": "\\\\(?:[btnfr\"\\\\/]|u[0-9A-Fa-f]{4})",
      "name": "constant.character.escape.pelago-manifest"
    },
    "empty": {
      "match": "(?<=\\s)(?:\\{\\}|\\[\\])(?=\\s|$)",
      "name": "constant.language.empty.pelago-manifest"
    },
    "boolean": {
      "match": "(?<=\\s)(?:true|false)(?=\\s|$)",
      "name": "constant.language.boolean.pelago-manifest"
    },
    "integer": {
      "match": "(?<=\\s)[+-]?\\d+(?=\\s|$)",
      "name": "constant.numeric.integer.pelago-manifest"
    }
  }
}
