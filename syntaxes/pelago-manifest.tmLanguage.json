{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pelago Manifest",
  "scopeName": "source.pelago-manifest",
  "patterns": [
    { "include": "#comment" },
    { "include": "#table-array" },
    { "include": "#table" },
    { "include": "#key" },
    { "include": "#value" }
  ],
  "repository": {
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.pelago-manifest",
      "captures": { "1": { "name": "punctuation.definition.comment.pelago-manifest" } }
    },
    "table-array": {
      "match": "^\\s*(\\[\\[)\\s*([^\\[\\]#]+?)\\s*(\\]\\])",
      "captures": {
        "1": { "name": "punctuation.definition.table.array.begin.pelago-manifest" },
        "2": { "name": "entity.name.section.pelago-manifest" },
        "3": { "name": "punctuation.definition.table.array.end.pelago-manifest" }
      }
    },
    "table": {
      "match": "^\\s*(\\[)\\s*([^\\[\\]#]+?)\\s*(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.table.begin.pelago-manifest" },
        "2": { "name": "entity.name.section.pelago-manifest" },
        "3": { "name": "punctuation.definition.table.end.pelago-manifest" }
      }
    },
    "key": {
      "match": "((?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'))*)\\s*(=)",
      "captures": {
        "1": { "name": "support.type.property-name.pelago-manifest" },
        "2": { "name": "keyword.operator.assignment.pelago-manifest" }
      }
    },
    "value": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string-multi-basic" },
        { "include": "#string-multi-literal" },
        { "include": "#string-basic" },
        { "include": "#string-literal" },
        { "include": "#datetime" },
        { "include": "#boolean" },
        { "include": "#float" },
        { "include": "#integer" },
        { "include": "#array" },
        { "include": "#inline-table" }
      ]
    },
    "string-multi-basic": {
      "begin": "\"\"\"",
      "end": "\"\"\"(?!\")",
      "name": "string.quoted.triple.basic.pelago-manifest",
      "patterns": [{ "include": "#escape" }]
    },
    "string-multi-literal": {
      "begin": "'''",
      "end": "'''(?!')",
      "name": "string.quoted.triple.literal.pelago-manifest"
    },
    "string-basic": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.pelago-manifest",
      "patterns": [{ "include": "#escape" }]
    },
    "string-literal": {
      "match": "'[^']*'",
      "name": "string.quoted.single.pelago-manifest"
    },
    "escape": {
      "match": "\\\\(?:[btnfr\"\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
      "name": "constant.character.escape.pelago-manifest"
    },
    "datetime": {
      "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?\\b|\\b\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?\\b",
      "name": "constant.other.datetime.pelago-manifest"
    },
    "boolean": {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.boolean.pelago-manifest"
    },
    "float": {
      "match": "[+-]?\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)|[+-]?\\b(?:inf|nan)\\b",
      "name": "constant.numeric.float.pelago-manifest"
    },
    "integer": {
      "match": "[+-]?(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|\\d[\\d_]*)",
      "name": "constant.numeric.integer.pelago-manifest"
    },
    "array": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.array.begin.pelago-manifest" } },
      "endCaptures": { "0": { "name": "punctuation.definition.array.end.pelago-manifest" } },
      "name": "meta.array.pelago-manifest",
      "patterns": [{ "include": "#value" }, { "match": ",", "name": "punctuation.separator.array.pelago-manifest" }]
    },
    "inline-table": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.table.inline.begin.pelago-manifest" } },
      "endCaptures": { "0": { "name": "punctuation.definition.table.inline.end.pelago-manifest" } },
      "name": "meta.table.inline.pelago-manifest",
      "patterns": [{ "include": "#key" }, { "include": "#value" }, { "match": ",", "name": "punctuation.separator.table.inline.pelago-manifest" }]
    }
  }
}
