{
  "name": "pelago",
  "displayName": "Pelago",
  "description": "Syntax highlighting, snippets and language-server support (errors as you type) for the Pelago language (.pel)",
  "version": "0.1.3",
  "publisher": "pelagolang",
  "license": "MIT OR Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B2239",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pelagolang/vscode-pelago.git"
  },
  "homepage": "https://github.com/pelagolang/vscode-pelago#readme",
  "bugs": {
    "url": "https://github.com/pelagolang/vscode-pelago/issues"
  },
  "keywords": [
    "pelago",
    "pel",
    "syntax",
    "highlighting",
    "snippets"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "scripts": {
    "check": "node scripts/check.js && node scripts/tokenize.js",
    "package": "npm run build && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/",
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --minify"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "esbuild": "0.25.10"
  },
  "contributes": {
    "languages": [
      {
        "id": "pelago",
        "aliases": [
          "Pelago",
          "pelago"
        ],
        "extensions": [
          ".pel"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon-light.svg",
          "dark": "./images/file-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pelago",
        "scopeName": "source.pelago",
        "path": "./syntaxes/pelago.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pelago",
        "path": "./snippets/pelago.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "source.pelago keyword.control.pelago",
              "source.pelago keyword.other.pelago"
            ],
            "settings": {
              "foreground": "#d9611c"
            }
          },
          {
            "scope": [
              "source.pelago storage.type.pelago",
              "source.pelago storage.type.function.pelago",
              "source.pelago keyword.declaration.pelago"
            ],
            "settings": {
              "foreground": "#0f93ab"
            }
          },
          {
            "scope": [
              "source.pelago storage.modifier.binding.pelago"
            ],
            "settings": {
              "foreground": "#0f93ab",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "source.pelago storage.modifier.access.pelago",
              "source.pelago entity.name.function.attribute.pelago"
            ],
            "settings": {
              "foreground": "#b07a10",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "source.pelago constant.language.pelago"
            ],
            "settings": {
              "foreground": "#8e63e6"
            }
          },
          {
            "scope": [
              "source.pelago variable.language.pelago"
            ],
            "settings": {
              "foreground": "#0f93ab",
              "fontStyle": "italic"
            }
          },
          {
            "scope": [
              "source.pelago keyword.other.soft.pelago"
            ],
            "settings": {
              "foreground": "#0f93ab"
            }
          },
          {
            "scope": [
              "source.pelago support.type.pelago",
              "source.pelago entity.name.type.pelago"
            ],
            "settings": {
              "foreground": "#1f9a6e"
            }
          },
          {
            "scope": [
              "source.pelago entity.name.function.pelago",
              "source.pelago entity.name.function.call.pelago",
              "source.pelago support.function.builtin.pelago"
            ],
            "settings": {
              "foreground": "#4f7be0"
            }
          },
          {
            "scope": [
              "source.pelago constant.numeric"
            ],
            "settings": {
              "foreground": "#b07a10"
            }
          },
          {
            "scope": [
              "source.pelago string.quoted"
            ],
            "settings": {
              "foreground": "#3f9a2a"
            }
          },
          {
            "scope": [
              "source.pelago constant.character.escape.pelago"
            ],
            "settings": {
              "foreground": "#6a9a1f"
            }
          },
          {
            "scope": [
              "source.pelago meta.interpolation.pelago"
            ],
            "settings": {
              "foreground": "#0f93ab",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "source.pelago variable.other.interpolation.pelago"
            ],
            "settings": {
              "foreground": "#0f93ab"
            }
          },
          {
            "scope": [
              "source.pelago comment"
            ],
            "settings": {
              "foreground": "#6a7f93",
              "fontStyle": "italic"
            }
          },
          {
            "scope": [
              "source.pelago keyword.operator.mark.pelago",
              "source.pelago keyword.operator.arrow.pelago"
            ],
            "settings": {
              "foreground": "#e0465f",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "source.pelago keyword.operator.optional.pelago"
            ],
            "settings": {
              "foreground": "#9a7ad6"
            }
          },
          {
            "scope": [
              "source.pelago keyword.operator.pelago",
              "source.pelago keyword.operator.range.pelago"
            ],
            "settings": {
              "foreground": "#7a8aa0"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "Pelago",
      "properties": {
        "pelago.serverPath": {
          "type": "string",
          "default": "pelago",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `pelago` executable that runs the language server (`pelago lsp`). The default looks `pelago` up on your PATH; on Windows use e.g. `C:\\\\tools\\\\pelago.exe`."
        },
        "pelago.semanticHighlighting": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use the language server's semantic tokens for colouring. Off by default so the TextMate colours stay as designed."
        }
      }
    },
    "commands": [
      {
        "command": "pelago.restartServer",
        "title": "Pelago: Restart Language Server"
      }
    ]
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:pelago"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
