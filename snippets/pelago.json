{
  "function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "function"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:name} {",
      "\t${2:field}: ${3:int}",
      "}"
    ],
    "description": "struct"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:name} {",
      "\t${2:first}",
      "\t${3:second}",
      "}"
    ],
    "description": "enum"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:value} {",
      "\tcase ${2:pattern}: ${3:result}",
      "\tdefault: ${0:other}",
      "}"
    ],
    "description": "switch with cases"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:item} of ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "for loop"
  },
  "closure": {
    "prefix": "closure",
    "body": [
      "${1:x} ~> ${0:x}"
    ],
    "description": "closure"
  },
  "derive": {
    "prefix": "derive",
    "body": [
      "@derive(${1:eq, show})"
    ],
    "description": "derive attribute"
  },
  "meta fn": {
    "prefix": "metafn",
    "body": [
      "meta fn ${1:name}() -> ${2:int} {",
      "\t$0",
      "}"
    ],
    "description": "compile-time function"
  },
  "test": {
    "prefix": "test",
    "body": [
      "test \"${1:what it checks}\" {",
      "\tassert(${0:true})",
      "}"
    ],
    "description": "test"
  },
  "braid": {
    "prefix": "braid",
    "body": [
      "const ${1:name}: braid<${2:int}, ${3:string}; ${4:4}> = ($0)"
    ],
    "description": "braid: N slots with alternating types"
  },
  "guard": {
    "prefix": "guard",
    "body": [
      "guard ${1:value} is ${2:pattern} else { ${0:return} }"
    ],
    "description": "guard with else"
  },
  "defer": {
    "prefix": "defer",
    "body": [
      "defer ${0:cleanup()}"
    ],
    "description": "defer a call to scope exit"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:interface} for ${2:type} {",
      "\t$0",
      "}"
    ],
    "description": "impl block"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import { ${1:name} } = std.${0:module}"
    ],
    "description": "import names from std"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "while loop"
  }
}
